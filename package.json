{
  "name": "jentic-api-scorecard-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "Workspace root for @jentic/api-scorecard.",
  "license": "Apache-2.0",
  "author": "Jentic <hello@jentic.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jentic/jentic-api-scorecard.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "lerna run build",
    "build:image": "docker build -t ghcr.io/jentic/jentic-api-scorecard:$npm_package_version ./docker",
    "clean": "lerna run clean",
    "dev": "npm run build && npm run build:image"
  },
  "devDependencies": {
    "lerna": "^9.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.10.0"
  }
}
